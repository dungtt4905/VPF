# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# JWT signing secrets (required). Use two different random strings, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Supabase Storage (S3 compatible)
S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="transactions"
S3_PUBLIC_BASE_URL="https://<project-ref>.supabase.co/storage/v1/object/public/transactions"
